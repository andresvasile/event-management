generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  CONSULTA
  COTIZADO
  ACEPTADO
  RESERVADO
  CONFIRMADO
  CANCELADO
  FINALIZADO
}

enum QuoteStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
  CANCELADA
}

enum Turn {
  MANANA
  TARDE
  NOCHE
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
}

enum GraduationPersonKind {
  EGRESADO
  FAMILIAR
}

enum GraduationPriceCategory {
  COMPLETA
  MENOR_SIN_CARGO
  MENOR_MITAD
  DISCAPACIDAD_SIN_CARGO
  DISCAPACIDAD_MITAD
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  role          String?      @default("user")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  emailVerified Boolean      @default(false)
  image         String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@map("user")
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  events         Event[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, phone])
  @@unique([id, organizationId])
}

model EventType {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                     String
  active                   Boolean      @default(true)
  supportsGraduationRoster Boolean      @default(false)
  events                   Event[]
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([organizationId, name])
  @@unique([id, organizationId])
}

model Event {
  id                  String             @id @default(cuid())
  organizationId      String
  clientId            String
  eventTypeId         String?
  date                DateTime           @db.Date
  turn                Turn
  status              EventStatus        @default(CONSULTA)
  guests              Int
  notes               String?
  graduationFullPrice Int?
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client             @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  eventType           EventType?         @relation(fields: [eventTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  quotes              Quote[]
  payments            Payment[]
  reminders           Reminder[]
  graduationSchools   GraduationSchool[]
  graduationPeople    GraduationPerson[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([organizationId, date, turn])
}

model GraduationSchool {
  id        String             @id @default(cuid())
  eventId   String
  name      String
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  graduates GraduationPerson[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId, name])
}

model GraduationPerson {
  id            String                  @id @default(cuid())
  eventId       String
  schoolId      String?
  graduateId    String?
  kind          GraduationPersonKind
  firstName     String
  lastName      String
  relationship  String?
  age           Int?
  priceCategory GraduationPriceCategory
  amountDue     Int
  notes         String?
  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  school        GraduationSchool?       @relation(fields: [schoolId, eventId], references: [id, eventId], onDelete: Restrict)
  graduate      GraduationPerson?       @relation("GraduateFamily", fields: [graduateId, eventId], references: [id, eventId], onDelete: Restrict)
  family        GraduationPerson[]      @relation("GraduateFamily")
  payments      GraduationPayment[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([id, eventId])
  @@index([eventId, lastName, firstName])
  @@index([schoolId])
  @@index([graduateId])
}

model GraduationPayment {
  id        String           @id @default(cuid())
  personId  String
  amount    Int
  method    PaymentMethod
  paidAt    DateTime         @db.Date
  note      String?
  person    GraduationPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([personId, paidAt])
}

model Service {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  basePrice      Int?
  active         Boolean      @default(true)
  required       Boolean      @default(false)
  items          QuoteItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

model Quote {
  id              String      @id @default(cuid())
  eventId         String      @unique
  status          QuoteStatus @default(BORRADOR)
  token           String      @unique
  expiresAt       DateTime    @db.Date
  requiredDeposit Int
  conditions      String
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items           QuoteItem[]
  payments        Payment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([id, eventId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  serviceId   String?
  serviceName String
  quantity    Int
  unitPrice   Int
  required    Boolean  @default(false)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model Payment {
  id        String        @id @default(cuid())
  eventId   String
  quoteId   String
  amount    Int
  method    PaymentMethod
  paidAt    DateTime      @db.Date
  note      String?
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  quote     Quote         @relation(fields: [quoteId, eventId], references: [id, eventId], onDelete: Restrict)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([eventId, paidAt])
  @@index([quoteId, eventId])
}

model Reminder {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  dueDate   DateTime @db.Date
  done      Boolean  @default(false)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  clients     Client[]
  eventTypes  EventType[]
  events      Event[]
  services    Service[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
